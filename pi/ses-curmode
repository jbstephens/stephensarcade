#!/usr/bin/env python3
"""Print the display's current mode as WxH@Hz (e.g. 1280x720@60).

Used by the ses-kiosk drift watchdog. Reads wlr-randr --json (the
human-readable output's "(current)" marker flaps between calls — the
original watchdog parsed it and failed silently for weeks). Exits 1 with
nothing on stdout if the current mode can't be determined.
"""
import json
import subprocess
import sys

try:
    p = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=5)
    for out in json.loads(p.stdout):
        if not out.get("enabled"):
            continue
        for m in out.get("modes", []):
            if m.get("current"):
                print(f'{m["width"]}x{m["height"]}@{round(m["refresh"])}')
                sys.exit(0)
    sys.exit(1)
except Exception:
    sys.exit(1)
