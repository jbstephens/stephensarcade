[Unit]
Description=Stephens Arcade — local offline web server (lighttpd, localhost:8080)
Documentation=https://github.com/jbstephens/stephensarcade
After=network.target

[Service]
# The document root is the offline tree produced by scripts/build-local.sh.
# setup.sh rewrites this line to the real checkout path before enabling the
# unit (default assumes the arcade user's ~/stephensarcade checkout).
Environment=SES_ARCADE_DOCROOT=/home/arcade/stephensarcade/local-arcade
Type=simple
# -D = run in the foreground (systemd owns the process lifecycle); -f = config.
ExecStart=/usr/sbin/lighttpd -D -f /etc/lighttpd/ses-arcade.conf
Restart=always
RestartSec=3
# Don't thrash forever if the config is broken — but never give up for good,
# because the kiosk falls back to online serving whenever this is down anyway.
StartLimitIntervalSec=0

# Hardening: this only ever serves static files on loopback.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
# local-arcade lives under the (read-only-protected) home, so lighttpd only
# needs read access — no writable paths required.

[Install]
WantedBy=multi-user.target
