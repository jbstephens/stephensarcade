[Unit]
Description=Stephens Arcade — periodic offline-tree sync
Documentation=https://github.com/jbstephens/stephensarcade

[Timer]
# First run shortly after boot (let Wi-Fi settle), then every 30 minutes —
# matching the live-site bundle sync cadence. Offline runs are cheap no-ops.
OnBootSec=3min
OnUnitActiveSec=30min
# If the Pi was off/asleep over a scheduled run, catch up once on wake.
Persistent=true

[Install]
WantedBy=timers.target
