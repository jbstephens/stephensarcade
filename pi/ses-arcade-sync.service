[Unit]
Description=Stephens Arcade — sync repo and rebuild the offline tree
Documentation=https://github.com/jbstephens/stephensarcade
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# setup.sh rewrites User/Environment to the real arcade user + checkout path.
User=arcade
Environment=SES_REPO_DIR=/home/arcade/stephensarcade
ExecStart=/usr/local/bin/ses-arcade-sync
# Bounded so a wedged git can't hang forever; the timer will try again later.
TimeoutStartSec=300
